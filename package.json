{
  "name": "microapp-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @microapp/studio-web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @microapp/studio-web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:check": "node scripts/check-docs.mjs --strict",
    "build:core": "node scripts/build-core.mjs"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "postcss": "8.5.25",
    "nanoid": "^3.3.17",
    "sharp": "0.35.3"
  }
}
