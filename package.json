{
  "name": "microapp-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @microapp/studio-web",
    "build": "npm run build:sandbox && npm run build:sqlite && npm run build --workspaces --if-present",
    "start": "npm run start -w @microapp/studio-web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:check": "node scripts/check-docs.mjs --strict",
    "build:core": "node scripts/build-core.mjs",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "build:sqlite": "node scripts/copy-sqlite-wasm.mjs",
    "e2e": "npm run e2e -w @microapp/studio-web",
    "dev:setup": "npm run build:core && npm run build:sqlite && npm run build:sandbox",
    "verify:web": "node scripts/verify-web.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "budget:check": "node scripts/check-budget.mjs",
    "errors:check": "node scripts/check-error-codes.mjs",
    "security:check": "node scripts/check-security.mjs",
    "migrations:test": "node scripts/test-migrations.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "postcss": "8.5.25",
    "nanoid": "^3.3.17",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.73.0"
  }
}
