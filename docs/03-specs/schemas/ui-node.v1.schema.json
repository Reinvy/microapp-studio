{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microapp.studio/schemas/ui-node.v1.schema.json",
  "title": "MUIP UI Node v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{1,39}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "props": {
      "type": "object",
      "maxProperties": 24,
      "properties": {
        "items": {
          "$ref": "#/$defs/complexList"
        },
        "options": {
          "$ref": "#/$defs/complexList"
        },
        "columns": {
          "$ref": "#/$defs/complexList"
        },
        "rows": {
          "$ref": "#/$defs/complexList"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        ]
      }
    },
    "children": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#"
      }
    },
    "on": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "press": {
          "$ref": "#/$defs/action"
        },
        "change": {
          "$ref": "#/$defs/action"
        },
        "submit": {
          "$ref": "#/$defs/action"
        },
        "focus": {
          "$ref": "#/$defs/action"
        },
        "blur": {
          "$ref": "#/$defs/action"
        },
        "longPress": {
          "$ref": "#/$defs/action"
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "navigate",
            "setState",
            "callBridge",
            "openSheet",
            "closeSheet",
            "toast"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "maxLength": 64
        },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "complexList": {
      "description": "Objek terbatas: array of flat objects with scalar values, used only by items/options/columns/rows.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
