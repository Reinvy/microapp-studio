{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microapp.studio/schemas/microapp.manifest.v2.schema.json",
  "title": "MicroApp Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "entry",
    "integrity",
    "signature",
    "offline",
    "permissions",
    "ui"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+){1,4}$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle"],
      "properties": {
        "bundle": {
          "type": "string",
          "pattern": "^bundle/[A-Za-z0-9._-]+\\.js$"
        }
      }
    },
    "assetsDir": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/$",
      "default": "assets/"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "contentHash", "files"],
      "properties": {
        "algorithm": { "enum": ["sha256"] },
        "contentHash": { "$ref": "#/$defs/hex64" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^(bundle|assets)/[A-Za-z0-9._/-]+$" },
          "additionalProperties": { "$ref": "#/$defs/hex64" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "enum": ["ed25519"] },
        "keyId": { "type": "string", "minLength": 8, "maxLength": 256 },
        "value": { "type": "string", "minLength": 16, "maxLength": 512 }
      }
    },
    "offline": { "type": "boolean" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "clipboard.read",
          "clipboard.write",
          "notifications.local",
          "files.pick",
          "network.fetch",
          "storage.app",
          "vault.read",
          "share.export"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ui.muip", "storage.app"] }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "protocol"],
      "properties": {
        "engine": { "const": "muip-web" },
        "protocol": { "const": 1 }
      }
    }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
