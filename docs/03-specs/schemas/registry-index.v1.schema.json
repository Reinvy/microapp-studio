{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microapp.studio/schemas/registry-index.v1.schema.json",
  "title": "Static Package Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "updatedAt", "apps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "url", "sha256", "signature", "permissions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+){1,4}$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signature": { "type": "string", "minLength": 16, "maxLength": 512 },
          "publicKey": { "type": "string", "minLength": 8, "maxLength": 256 },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "clipboard.read",
                "clipboard.write",
                "notifications.local",
                "files.pick",
                "network.fetch",
                "storage.app",
                "vault.read",
                "share.export"
              ]
            }
          },
          "description": { "type": "string", "maxLength": 280 }
        }
      }
    }
  }
}
