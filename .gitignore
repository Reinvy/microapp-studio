# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# GitHub token for cron agents (never commit)
.github_token

# vercel
.vercel

# E2E test artifacts
/e2e-output/
/e2e-report/
/e2e-results.json
/e2e-summary.md
/test-results/

# typescript
*.tsbuildinfo
next-env.d.ts
